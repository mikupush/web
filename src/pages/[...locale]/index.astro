---
import "@/styles/global.css";
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import CloudContainer from "@/components/CloudContainer.astro";
import Features from "@/components/Features.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { buildStaticPaths } from "astro-react-i18next/utils";
import i18n, {t} from "i18next";
import Downloads from "@/components/Downloads.astro";

export function getStaticPaths() {
  return buildStaticPaths();
}
---
<html lang={i18n.language}>
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content={`${t('hero_title')}. ${t('hero_subtitle')}.`} />
  <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  <title>Mikupush</title>
  <script>
    import { getCurrentTheme, applyTheme } from "@/lib/theme.ts";

    applyTheme(getCurrentTheme())
  </script>
</head>
<body>
<Layout>
  <Header/>
  <main class="flex-1 flex flex-col">
    <Hero/>
    <CloudContainer>
      <Features/>
      <div class="h-25"></div>
      <Downloads />
    </CloudContainer>
  </main>
  <Footer/>
</Layout>
</body>
</html>
