import i18n, {t} from 'i18next'
import LinuxIcon from './icons/LinuxIcon'
import DownloadButton from "@/components/DownloadButton.tsx";
import AppleIcon from './icons/AppleIcon';
import WindowsIcon from './icons/WindowsIcon';
import {Separator} from './ui/separator'
import MikuPC from "@/components/MikuPC.tsx";
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { TriangleAlert } from 'lucide-react';

const lang = i18n.language
---

<section id="downloads">
  <h2 class="mb-20 text-3xl md:text-4xl font-extrabold text-center">
    <span aria-hidden="true">💾</span> {t('download_now')}
  </h2>

  <div class="md:w-4xl mx-auto relative">
    <div class="space-y-15 mb-15">
      <div>
        <h3 class="text-2xl md:text-3xl font-bold mb-10 flex items-end">
          <AppleIcon className="inline-block w-10 h-10 mr-3" /> macOS
        </h3>
        <div class="space-y-3">
          <div>
            <DownloadButton artifact="macos-apple-silicon" client:load>
              {t('download_macos_apple')}
            </DownloadButton>
          </div>

          <div>
            <DownloadButton artifact="macos-intel" client:load>
              {t('download_macos_intel')}
            </DownloadButton>
          </div>
        </div>
      </div>
      <Separator className="w-full md:w-1/2" />
      <div>
        <h3 class="text-2xl md:text-3xl font-bold mb-10 flex items-end">
          <LinuxIcon className="inline-block w-10 h-10 mr-3" /> Linux
        </h3>
        <div class="space-y-3">
          <div>
            <DownloadButton artifact="linux-deb" client:load>
              {t('download_linux_deb')}
            </DownloadButton>
          </div>
          <div>
            <DownloadButton artifact="linux-rpm" client:load>
              {t('download_linux_rpm')}
            </DownloadButton>
          </div>
        </div>
      </div>
      <Separator className="w-full md:w-1/2" />
      <div>
        <h3 class="text-2xl md:text-3xl font-bold mb-10 flex items-end">
          <WindowsIcon className="inline-block w-10 h-10 mr-3" /> Windows
        </h3>
        <Alert className="mb-5">
          <TriangleAlert className="size-5" />
          <AlertTitle className="text-left text-lg">{t('not_code_signed')}</AlertTitle>
          <AlertDescription className="text-left">
            {t('not_code_signed_windows')}&nbsp;
            <a class="underline" href={lang !== 'en' ? `/${lang}/docs/client/building-from-source` : '/docs/client/building-from-source'}>
              {t('build_from_source')}
            </a>
          </AlertDescription>
        </Alert>
        <DownloadButton artifact="windows" client:load>{t('download_windows')}</DownloadButton>
      </div>
    </div>
    <MikuPC className="absolute w-1/2 hidden md:block right-0 top-1/7 z-10 h-96" />
  </div>
</section>
