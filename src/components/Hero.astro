---
import DownloadButton from "@/components/DownloadButton.tsx";
import { useTranslation } from "@/hooks/i18n";
const { t } = useTranslation();
---
<section class="flex flex-col py-16 z-10">
  <div class="flex-1 flex flex-col items-center justify-center px-6 text-center">
    <h1 id="hero-title" class="text-3xl md:text-5xl font-bold text-on-background max-w-2xl leading-tight">
      <span class="font-emoji">⚡</span> {t('hero_title')}
    </h1>

    <p class="mt-4 text-base md:text-lg text-on-background/80">
      {t('hero_subtitle')}
    </p>

    <div class="mt-6 flex flex-col items-center">
      <DownloadButton client:load />
      <a href="#download" class="mt-3 text-sm font-medium opacity-90 hover:opacity-100 underline">
        {t('or_other')}
      </a>
    </div>
  </div>
</section>
